# ===========================================================================
# Dockerfile.base  ->  image: alerts-base
#
# The "base" layer, analogous to the cholera-mapping-pipeline base image:
# R + system libraries + the heavy/common R packages shared across builds.
# The app-specific packages and the app code go in the child image
# (see Dockerfile, which starts FROM alerts-base).
#
# Build:
#   docker build -f Dockerfile.base -t alerts-base:1.0 -t alerts-base:latest .
# ===========================================================================

# Pin the R version we developed and tested against (Ubuntu 22.04 "jammy").
FROM rocker/r-ver:4.3.3

# --- System libraries required by the app's R packages --------------------
# xml2 (kableExtra) -> libxml2-dev; curl/ssl -> web + package installs;
# the font/graphics libs are needed to render ggplot2 / patchwork plots.
RUN apt-get update && apt-get install -y --no-install-recommends \
      pandoc \
      libcurl4-openssl-dev \
      libssl-dev \
      libxml2-dev \
      libfontconfig1-dev \
      libfreetype6-dev \
      libharfbuzz-dev \
      libfribidi-dev \
      libpng-dev \
      libtiff5-dev \
      libjpeg-dev \
      libcairo2-dev \
      locales \
 && rm -rf /var/lib/apt/lists/*

# --- UTF-8 locale ----------------------------------------------------------
# The alert-definition labels contain the ">=" glyph; a UTF-8 locale ensures
# it renders (the app also sets this defensively at startup).
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# --- Reproducible package versions ----------------------------------------
# Freeze on a dated Posit Public Package Manager snapshot so rebuilds get the
# same versions. The __linux__/jammy path serves precompiled binaries (fast).
# Change the date to the snapshot you want to lock on; keep "jammy" in sync
# with the base image's Ubuntu codename.
RUN echo 'options(repos = c(CRAN = "https://packagemanager.posit.co/cran/__linux__/jammy/2025-01-31"))' \
      >> /usr/local/lib/R/etc/Rprofile.site

# --- Common / heavy packages shared across builds -------------------------
## `arrow` (for Parquet I/O) installs from Posit Package Manager's precompiled
## Ubuntu jammy binaries via the repo option above, so it does not need to
## compile Arrow C++ from source or any extra apt-level libarrow packages.
RUN R -q -e "install.packages(c('shiny','dplyr','tidyr','ggplot2','arrow'))"
